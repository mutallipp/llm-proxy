# llm-proxy 本地 Docker 配置示例
# 复制为 .env 后填写真实值：cp .env.example .env

AXONHUB_DB_DIALECT=postgres
AXONHUB_DB_DSN=postgres://<user>:<password>@<host>:5432/<database>?sslmode=disable
AXONHUB_SERVER_API_AUTH_ALLOW_NO_AUTH=true

# 公司 VPN/宿主机代理（没有代理时留空）
# macOS Docker Desktop 示例： http://host.docker.internal:<proxy-port>
AXONHUB_HTTP_PROXY=
AXONHUB_HTTPS_PROXY=
AXONHUB_ALL_PROXY=
AXONHUB_NO_PROXY=localhost,127.0.0.1,postgres,redis,host.docker.internal

# Antigravity OAuth 凭证只通过环境变量注入，不要写入 Git。
ANTIGRAVITY_GOOGLE_CLIENT_ID=
ANTIGRAVITY_GOOGLE_CLIENT_SECRET=
