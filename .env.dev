# llm-proxy dev 环境变量
# 复制此文件为 .env.dev 真实使用，并按需覆盖敏感字段。
# 注意：与 prod 的 .env 完全分离——dev 容器读这里，prod 容器读 ../.env。

# ── 数据库 ─────────────────────────────────────────────────────
# dev 库 llm-proxy-dev 与 prod 库 llm-proxy 分离。
# 数据库凭据只写在本机忽略的 .env.dev.local，勿提交到仓库：
#   LLM_PROXY_DB_DSN=postgres://<username>:<password>@postgres:5432/llm-proxy-dev?sslmode=disable
# 首次初始化可用 make dev-db-sync-schema；需要完整线上副本则用 make dev-db-sync-full。
LLM_PROXY_DB_DIALECT=postgres

# ── 服务监听 ───────────────────────────────────────────────────
# 容器内仍监听 8090；端口映射在 docker-compose.dev.yml 里处理（18090:8090）
LLM_PROXY_SERVER_HOST=0.0.0.0
LLM_PROXY_SERVER_PORT=8090

# ── MVP：允许消费入口不携带 API Key ────────────────────────────
LLM_PROXY_SERVER_API_AUTH_ALLOW_NO_AUTH=true

# ── 日志（dev 默认 debug 级别） ────────────────────────────────
LLM_PROXY_LOG_LEVEL=debug
LLM_PROXY_LOG_ENCODING=console

# ── 代理（可选；与 prod 共享同一台代理） ─────────────────────
LLM_PROXY_HTTP_PROXY=${LLM_PROXY_HTTP_PROXY:-}
LLM_PROXY_HTTPS_PROXY=${LLM_PROXY_HTTPS_PROXY:-}
LLM_PROXY_ALL_PROXY=${LLM_PROXY_ALL_PROXY:-}
LLM_PROXY_NO_PROXY=${LLM_PROXY_NO_PROXY:-localhost,127.0.0.1,postgres,redis,host.docker.internal}
